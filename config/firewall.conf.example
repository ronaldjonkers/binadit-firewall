# =============================================================================
# binadit-firewall v3.1.0 - Configuration File
# =============================================================================
# Location: /etc/binadit-firewall/firewall.conf
#
# This file is sourced as a bash script. Use bash variable syntax.
# Separate multiple values with spaces.
#
#   Ports      single (80) or a range with a colon (8000:9000)
#   Addresses  IPv4 (1.2.3.4), IPv6 (2001:db8::1), CIDR (10.0.0.0/24),
#              range (1.2.3.4-1.2.3.9) or hostname (office.example.com)
#
# How traffic is handled:
#   Incoming   dropped, unless allowed below
#   Outgoing   allowed, unless blocked below
#
# After editing:  binadit-firewall configtest   (check for mistakes)
#                 binadit-firewall reload       (apply — atomic, no downtime)
# =============================================================================

# -----------------------------------------------------------------------------
# OPEN PORTS (incoming)
# -----------------------------------------------------------------------------
# TCP ports open to everyone
# Example: "80 443 8080 20000:25000"
TCP_PORTS="80 443"

# Same as TCP_PORTS (kept for compatibility with older configs)
TCP_PORTS_INPUT=""

# UDP ports open to everyone
# Example: "53 123 51820"
UDP_PORTS=""

# -----------------------------------------------------------------------------
# BLOCKED PORTS
# -----------------------------------------------------------------------------
# TCP/UDP ports blocked in BOTH directions. These win over every allow rule,
# including trusted IPs.
# Example: "23 135 139 445"
BLOCKED_TCP_PORTS=""
BLOCKED_UDP_PORTS=""

# Ports blocked for OUTGOING traffic only
# Example: "25 465 587" stops this server from sending mail directly
BLOCKED_TCP_PORTS_OUTPUT=""
BLOCKED_UDP_PORTS_OUTPUT=""

# -----------------------------------------------------------------------------
# SSH ACCESS
# -----------------------------------------------------------------------------
# SSH port(s). Leave empty to detect them automatically from sshd.
SSH_PORT=""

# Restrict SSH to these addresses/hostnames.
# Empty = SSH is open to everyone (you can never lock yourself out).
# When set, SSH is closed for everyone else — even if the SSH port is also
# listed in TCP_PORTS.
# Example: "1.2.3.4 office.example.com 10.0.0.0/24 2001:db8::/32"
SSH_ALLOWED_IPS=""

# Additional entries (same meaning; kept for compatibility)
SSH_ALLOWED_IPS_IPV6=""

# -----------------------------------------------------------------------------
# TRUSTED IPS (full access)
# -----------------------------------------------------------------------------
# Full access to every port, exempt from all rate limits.
# Example: "1.2.3.4 office.example.com 10.0.0.0/8"
TRUSTED_IPS=""
TRUSTED_IPS_IPV6=""

# Same, for ranges
# Example: "192.168.1.1-192.168.1.254"
TRUSTED_RANGES=""
TRUSTED_RANGES_IPV6=""

# -----------------------------------------------------------------------------
# BLACKLIST (blocked completely)
# -----------------------------------------------------------------------------
# Blocked in both directions, including already open connections.
# Example: "1.2.3.4 5.6.7.0/24 bad-actor.example.com"
BLACKLIST=""
BLACKLIST_IPV6=""

# Same, for ranges
# Example: "65.208.151.1-65.208.151.254"
BLOCKED_RANGES=""
BLOCKED_RANGES_IPV6=""

# -----------------------------------------------------------------------------
# PORT-SPECIFIC IP RULES
# -----------------------------------------------------------------------------
# Open a port for specific addresses only (do NOT also list it in TCP_PORTS).
# Format: one rule per line:  protocol|port|address
#
# Example:
# PORT_IP_RULES="tcp|3306|10.0.0.5
# tcp|5432|db-client.example.com
# tcp|6379|192.168.1.0/24
# udp|5060|sip.example.com"
PORT_IP_RULES=""

# -----------------------------------------------------------------------------
# HOSTNAMES
# -----------------------------------------------------------------------------
# Hostnames used above are resolved to their IPv4 and IPv6 addresses when the
# rules are loaded, and re-checked every DNS_REFRESH_INTERVAL minutes. When an
# address behind a hostname changed, the rules are reloaded automatically.
# 0 = never re-check (addresses only update on reload/restart).
DNS_REFRESH_INTERVAL="5"

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# Limit new TCP connections per source IP (IPv6: per /64 network).
# Trusted IPs and the SSH allow-list are never limited.
RATE_LIMIT_ENABLE="true"

# Sustained new connections per source IP: "25" (per second) or "600/minute"
RATE_LIMIT_RATE="25"

# Extra connections one IP may open in a short burst on top of the rate
RATE_LIMIT_BURST="100"

# Optional hard cap on new TCP connections per second per source IP, without
# burst allowance. 0 = disabled.
CONN_RATE_PER_IP="0"

# Limit concurrent TCP connections per source IP
CONN_LIMIT_ENABLE="false"
CONN_LIMIT_PER_IP="50"

# -----------------------------------------------------------------------------
# SECURITY HARDENING
# -----------------------------------------------------------------------------
# SYN flood protection: enables kernel SYN cookies and drops TCP packets with
# impossible flag combinations
SYN_FLOOD_PROTECT="true"

# Drop packets that do not belong to any known connection
DROP_INVALID="true"

# Silently drop probes on ports 23, 135, 137-139, 445 and 1900 (telnet,
# netbios, SMB, SSDP) so they do not flood the log. A port you open explicitly
# in TCP_PORTS/UDP_PORTS stays open.
BLOCK_COMMON_ATTACKS="true"

# -----------------------------------------------------------------------------
# FEATURES
# -----------------------------------------------------------------------------
# Answer ping (IPv4 and IPv6). ICMPv6 needed for IPv6 itself is always allowed.
ICMP_ENABLE="true"

# Accept multicast and broadcast traffic (clusters, VRRP, load balancers)
MULTICAST_ENABLE="false"

# Log dropped packets to the kernel log (max 5 per minute)
# View: journalctl -k | grep binadit-drop
LOG_DROPPED="true"

# -----------------------------------------------------------------------------
# NAT / ROUTING
# -----------------------------------------------------------------------------
# Act as a NAT router for a LAN (gateway setups)
NAT_ENABLE="false"

# External network interface (internet-facing)
NAT_EXTERNAL_IFACE="eth0"

# Internal network interface (LAN-facing)
NAT_INTERNAL_IFACE="eth1"

# -----------------------------------------------------------------------------
# PORT FORWARDING (DNAT)
# -----------------------------------------------------------------------------
# Forward ports arriving on the external interface to hosts on the LAN.
# Requires NAT_ENABLE="true".
# Format: one rule per line:  protocol|external_port|internal_ip:internal_port
#
# Example:
# PORT_FORWARD_RULES="tcp|8080|192.168.1.100:80
# tcp|2222|192.168.1.100:22
# udp|51820|192.168.1.200:51820"
PORT_FORWARD_RULES=""

# -----------------------------------------------------------------------------
# CUSTOM RULES
# -----------------------------------------------------------------------------
# File with additional raw rules, loaded after the managed rules on every
# start/reload. nftables backend: nft syntax (e.g. "add rule inet binadit
# input ..."). iptables backend: iptables-restore syntax.
# Example: CUSTOM_RULES_FILE="/etc/binadit-firewall/custom.rules"
CUSTOM_RULES_FILE=""

# -----------------------------------------------------------------------------
# ADVANCED
# -----------------------------------------------------------------------------
# Debug logging. Can also be set via environment: BINADIT_DEBUG=true
BINADIT_DEBUG="false"

# -----------------------------------------------------------------------------
# DEPRECATED (no effect, kept so older configs keep loading)
# -----------------------------------------------------------------------------
# Outgoing traffic is always allowed; use BLOCKED_TCP_PORTS_OUTPUT to block.
TCP_PORTS_OUTPUT=""
SMTP_ENABLE="true"
